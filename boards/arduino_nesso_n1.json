    "f_cpu": "160000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32c6",
    "variant": "arduino_nesso_n1"
  },
  "connectivity": [
    "bluetooth",
    "wifi"
  ],
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "Arduino Nesso N1",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://docs.arduino.cc/hardware/nesso-n1",
  "vendor": "Arduino"
